# Copy to .env and fill in real values. .env is gitignored + dockerignored.
# docker-compose.yml reads from .env automatically.

# --- LLM ---
ANTHROPIC_API_KEY=
# Anthropic model ID, e.g. `claude-haiku-4-5-20251001`. Required.
ANTHROPIC_MODEL=

# --- Apify (job source) ---
APIFY_TOKEN=

# --- Google (service account auth for Sheets + Drive) ---
# Paste the full JSON key on a single line. Use: jq -c . your-key.json
GCP_SERVICE_ACCOUNT_JSON=

# Sheet with two tabs: `Jobs` and `Costs`
GOOGLE_SHEET_ID=

# Drive file IDs (share each with the service account email)
GOOGLE_DRIVE_RESUME_FILE_ID=
GOOGLE_DRIVE_CONFIG_FILE_ID=

# --- Email digest (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
RECIPIENT_EMAIL=

# --- Runtime ---
# 1 = skip Sheet writes + email; 0 = real run. Compose defaults to 1.
DRY_RUN=1

# MCP server transport. `stdio` (default) = subprocess JSON-RPC over stdin/stdout;
# `http` = listen on 0.0.0.0:8000. Use http for ngrok / Cloud Run.
MCP_TRANSPORT=stdio

# --- MCP HTTP auth (required only when MCP_TRANSPORT=http) ---
# Google OAuth 2.0 Web Application credentials. Create in GCP Console:
# APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web application).
# Authorized redirect URIs must include <MCP_BASE_URL>/auth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public base URL the MCP server is reachable at (no trailing slash).
# Local: http://localhost:8000. Prod: https://<service>-<hash>.<region>.run.app.
MCP_BASE_URL=

# Comma-separated allowlist of Google account emails permitted to use the server.
# Authenticated users outside this list are rejected.
MCP_ALLOWED_EMAILS=
